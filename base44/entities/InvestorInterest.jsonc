{
  "name": "InvestorInterest",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_title": {
      "type": "string"
    },
    "investor_user_id": {
      "type": "string"
    },
    "investor_name": {
      "type": "string"
    },
    "interest_type": {
      "type": "string",
      "enum": [
        "EQUITY",
        "DEBT",
        "JOINT_VENTURE",
        "STRATEGIC_PARTNERSHIP",
        "ACQUISITION",
        "TECHNOLOGY_PARTNERSHIP",
        "INFORMATION_REQUEST",
        "OTHER"
      ],
      "default": "EQUITY"
    },
    "investment_capacity": {
      "type": "number",
      "description": "Investor capacity in MTND"
    },
    "preferred_ticket": {
      "type": "number"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "CONTACTED",
        "IN_REVIEW",
        "CLOSED"
      ],
      "default": "NEW"
    }
  },
  "required": [
    "project_id",
    "investor_user_id",
    "interest_type"
  ],
  "rls": {
    "create": {
      "data.investor_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.investor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.investor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.investor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}