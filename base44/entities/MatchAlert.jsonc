{
  "name": "MatchAlert",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who owns these match alert settings"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "organization_id": {
      "type": "string",
      "description": "InvestmentOrganization used as the alert basis (the user's investment mandate)"
    },
    "seen_project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project IDs already surfaced, so only new matches alert"
    },
    "last_checked": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}